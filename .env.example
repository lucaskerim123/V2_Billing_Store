# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase access for Billing Store data/auth workflows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# License Master API authority. This is the API origin only, never the admin panel.
LICENSE_MASTER_URL=https://api.incendiarynetworks.cc
MASTER_API_TIMEOUT_MS=10000

# Server-only License Master managed API keys.
# BILLING_API_TOKEN must have the billing/licensing/release scopes required by Billing Store.
# DEPLOYER_API_TOKEN must have the deployment/artifact scopes required by deployer operations.
BILLING_API_TOKEN=<license-master-managed-api-key>
DEPLOYER_API_TOKEN=<license-master-managed-api-key>

# Required by the Vercel cron endpoint.
CRON_SECRET=generate-a-long-random-secret

# Public Billing Store origin.
SITE_URL=https://orbitfsstore.vercel.app
NEXT_PUBLIC_ORBITFS_STORE_URL=https://orbitfsstore.vercel.app
