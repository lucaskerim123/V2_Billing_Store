# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase access for Billing Store data/auth workflows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only License Master V2 authority.
MASTER_API_URL=https://customlicensev1.vercel.app
MASTER_API_TIMEOUT_MS=10000

# Server-only License Master managed API key. The same key may be used for both roles if it has all required scopes.
BILLING_API_TOKEN=<license-master-managed-api-key>
DEPLOYER_API_TOKEN=<license-master-managed-api-key>

# Required by the Vercel cron endpoint.
CRON_SECRET=generate-a-long-random-secret

# Public Billing Store origin.
SITE_URL=https://orbitfsstore.vercel.app
NEXT_PUBLIC_ORBITFS_STORE_URL=https://orbitfsstore.vercel.app
