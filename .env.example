# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase access for Billing Store data/auth workflows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only OrbitFS License Master authority.
MASTER_API_URL=https://your-license-master-domain
MASTER_API_TIMEOUT_MS=10000

# Billing Store -> License Master connector credentials. Never expose to browser code.
BILLING_API_TOKEN=<server-only-billing-token>
DEPLOYER_API_TOKEN=<server-only-deployer-token>

# MASTER_API_TOKEN belongs to License Master itself and must never be configured in Billing Store.

# Required by the Vercel cron endpoint.
CRON_SECRET=generate-a-long-random-secret

# Optional payment/email settings used by the Store integrations.
SITE_URL=https://your-store-domain
