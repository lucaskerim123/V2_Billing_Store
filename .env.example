# ORBITFS V2 BILLING STORE — PRODUCTION ENVIRONMENT
# Billing Store owns commerce/customer workflows.
# License Master remains the TOP technical licensing/release authority.
# All machine credentials below are managed API keys issued by License Master.
# Never expose server secrets to browser code or commit real values.

# ---------------------------------------------------------------------------
# SUPABASE — same shared OrbitFS/License Master database
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# LICENSE MASTER
# ---------------------------------------------------------------------------
# API origin only. Versioned integration routes are /api/v1/*.
LICENSE_MASTER_URL=https://incendiarynetworks.cc/api
MASTER_API_TIMEOUT_MS=10000
MASTER_API_CACHE_SECONDS=30

# License Master managed key: licensing, products, entitlements and releases.
BILLING_API_TOKEN=use-the-License-Master-managed-billing-key

# License Master managed key: deployment/update operations.
DEPLOYER_API_TOKEN=use-the-License-Master-managed-deployer-key

# MASTER_API_TOKEN belongs ONLY to License Master.
# INTEGRATION_API_TOKEN is legacy and is not needed for this integration.

CRON_SECRET=replace-with-long-random-cron-secret

SITE_URL=https://orbitfsstore.vercel.app
NEXT_PUBLIC_ORBITFS_STORE_URL=https://orbitfsstore.vercel.app

# Non-License-Master deployment credentials, only if the deployment workflow
# actually needs them. Keep them in Vercel/GitHub secret stores.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# FLOW
# Billing Store -> License Master:
#   BILLING_API_TOKEN  for licensing/release/commerce operations.
#   DEPLOYER_API_TOKEN for deployment/update operations.
# License Master remains the authority that creates, scopes, rotates and
# revokes these managed credentials.
