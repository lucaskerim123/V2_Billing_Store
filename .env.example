# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase access for Billing Store data/auth workflows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only License Master V2 authority.
MASTER_API_URL=https://incendiarynetworks.cc
MASTER_API_TIMEOUT_MS=10000

# Billing Store -> License Master V2 connector credentials. Never expose to browser code.
BILLING_API_TOKEN=<server-only-billing-token>
DEPLOYER_API_TOKEN=<server-only-deployer-token>

# MASTER_API_TOKEN belongs to License Master V2 itself and must never be configured in Billing Store.

# Required by the Vercel cron endpoint.
CRON_SECRET=generate-a-long-random-secret

# Public Billing Store origin.
SITE_URL=https://orbitfsstore.vercel.app
NEXT_PUBLIC_ORBITFS_STORE_URL=https://orbitfsstore.vercel.app
