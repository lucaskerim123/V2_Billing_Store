# ORBITFS V2 BILLING STORE — PRODUCTION ENVIRONMENT
# Billing Store owns commerce/customer workflows and its own database.
# License Master remains the TOP technical licensing/release authority.
# Never point Billing Store at the License Master Supabase project.
# All machine credentials below are managed API keys issued by License Master.
# Never expose server secrets to browser code or commit real values.

# ---------------------------------------------------------------------------
# SUPABASE — dedicated V2 Billing Store database
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# LICENSE MASTER
# ---------------------------------------------------------------------------
# API origin only. Versioned integration routes are /api/v1/*.
# License Manager API origin is resolved from official registry / shared Billing DB.
# Do not add MASTER_API_URL or LICENSE_MASTER_URL: the runtime does not use them.
# Optional overrides (defaults: 10000ms, 30s):
# MASTER_API_TIMEOUT_MS=10000
# MASTER_API_CACHE_SECONDS=30

# License Master managed key: licensing, products, entitlements and releases.
BILLING_API_TOKEN=use-the-License-Master-managed-billing-key

# License Master managed key: deployment/update operations.
DEPLOYER_API_TOKEN=use-the-License-Master-managed-deployer-key

# MASTER_API_TOKEN belongs ONLY to License Master.
# INTEGRATION_API_TOKEN is legacy and is not needed for this integration.

CRON_SECRET=replace-with-long-random-cron-secret

# One public storefront origin for MAIN and FALLBACK, not a distinct fallback URL.
# The shared DB app_settings.site.public_url is authoritative when present.
NEXT_PUBLIC_ORBITFS_STORE_URL=https://orbitfsstore.vercel.app
# SITE_URL is a legacy fallback: do not duplicate it.

# ---------------------------------------------------------------------------
# ORBITFS MAIL — Resend is transport only; sender identities/templates live in Supabase
# ---------------------------------------------------------------------------
# Required for outbound system, support and billing mail.
RESEND_API_KEY=

# Optional dedicated receiving/mailbox key. If omitted, inbox operations fall back
# to RESEND_API_KEY.
# RESEND_MAIL_API_KEY=  # Optional: only if receiving/mailbox uses separate Resend key.

# Non-License-Master deployment credentials, only if the deployment workflow
# actually needs them. Keep them in Vercel/GitHub secret stores.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# FLOW
# Billing Store -> License Master:
#   BILLING_API_TOKEN  for licensing/release/commerce operations.
#   DEPLOYER_API_TOKEN for deployment/update operations.
# License Master remains the authority that creates, scopes, rotates and
# revokes these managed credentials.

# ---------------------------------------------------------------------------
# DEV PANEL OPERATIONAL RELEASE HISTORY
# ---------------------------------------------------------------------------
DEV_PANEL_URL=https://dev.incendiarynetworks.cc
DEV_PANEL_EVENT_SECRET=replace-with-the-same-secret-configured-on-dev-panel
