# ============================================================
# ORBITFS V2 BILLING STORE — PRODUCTION ENVIRONMENT
# ============================================================
# Runtime: Vercel Production
# Authority: commerce + customer-facing release publication
#
# License Manager remains the technical licensing/release authority.
# Billing Store must never become the licensing authority.
# NEVER commit real secrets to Git.
# ============================================================

# ============================================================
# 01 — SUPABASE PUBLIC PROJECT SETTINGS
# Browser-safe values. These are NOT service credentials.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ============================================================
# 02 — SUPABASE SERVER AUTHORITY
# Server-only. NEVER expose this as NEXT_PUBLIC_*.
# Used for Billing Store backend data/auth/automation workflows.
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# 03 — LICENSE MASTER CONNECTION
# License Manager API is the canonical technical authority.
# Do not point this at the admin panel.
# ============================================================
LICENSE_MASTER_URL=https://incendiarynetworks.cc/api
MASTER_API_TIMEOUT_MS=10000

# ============================================================
# 04 — LICENSE MASTER MANAGED SERVICE CREDENTIALS
# These credentials are issued/controlled by License Manager.
#
# BILLING_API_TOKEN:
#   Billing Store → License Manager billing/licensing/release APIs.
#
# DEPLOYER_API_TOKEN:
#   Billing Store/deployer backend → deployment/artifact operations.
#
# Reuse the stable credentials until intentionally rotated.
# Do not create a new token every time the store is reconfigured.
# ============================================================
BILLING_API_TOKEN=use-the-stable-license-manager-billing-api-token
DEPLOYER_API_TOKEN=use-the-stable-license-manager-deployer-api-token

# ============================================================
# 05 — BILLING STORE CRON SECURITY
# Server-only secret used by the Vercel cron endpoint.
# Must be a long random value.
# ============================================================
CRON_SECRET=replace-with-long-random-cron-secret

# ============================================================
# 06 — PUBLIC BILLING STORE URLS
# ============================================================
SITE_URL=https://orbitfsstore.vercel.app
NEXT_PUBLIC_ORBITFS_STORE_URL=https://orbitfsstore.vercel.app

# ============================================================
# 07 — VERCEL / GITHUB DEPLOYMENT CREDENTIALS
# These are NOT application runtime variables unless a workflow
# explicitly needs them. Keep them in GitHub/Vercel secret stores.
#
# GitHub Actions secret:
#   VERCEL_TOKEN
#
# License Manager / deployment control GitHub secret where required:
#   GITHUB_ACTIONS_TOKEN
#
# GitHub deployment variables:
#   VERCEL_ORG_ID
#   VERCEL_PROJECT_ID
#
# Vercel automatically provides deployment metadata such as
# VERCEL_GIT_COMMIT_SHA.
# ============================================================
