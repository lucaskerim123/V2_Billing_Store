{
  "name": "billing-mail-configuration",
  "displayName": "Billing Mail Configuration",
  "version": "1.0.0",
  "scope": "external-system-addon",
  "serverOnly": true,
  "requires": [
    "MAIL_SYSTEM_URL",
    "MAIL_SYSTEM_API_KEY"
  ],
  "owns": [
    "templates",
    "template_revisions",
    "routing_rules",
    "event_triggers",
    "recipient_mapping",
    "application_settings",
    "appearance"
  ],
  "connectsTo": "Mail System API",
  "entrypoints": {
    "client": "./dist/client.js",
    "configuration": "./dist/configuration.js",
    "automation": "./dist/module.js",
    "renderer": "./dist/renderer.js",
    "adminUi": "./dist/admin-ui.js",
    "console": "./dist/console.js",
    "server": "./dist/module.js",
    "store": "./dist/supabase-store.js",
    "remoteStaff": "./dist/remote-staff.js",
    "remoteStaffTypes": "./dist/remote-staff-types.js",
    "remoteStaffAdmin": "./dist/remote-staff-admin.js"
  },
  "features": [
    "template-management",
    "template-preview",
    "variable-discovery",
    "event-triggers",
    "conditional-sender-routing",
    "scoped-api-key-capabilities",
    "application-enable-disable",
    "theme-customization",
    "remote-staff-provisioning",
    "remote-user-session-exchange",
    "delegated-mailbox-access",
    "employment-lifecycle-sync",
    "remote-staff-admin-component"
  ],
  "installable": true,
  "buildOnly": false
}
